# Copy this file to .env and fill in real values. .env is gitignored - it never gets committed.
# Publishing to Vimeo is entirely optional: if none of the VIMEO_* values below are set, the app
# works exactly as before and simply never offers the "publish to Vimeo" option.
#
# Two ways to connect Vimeo - use ONE of them, not both:
#  1. VIMEO_ACCESS_TOKEN alone: a personal access token, generated by hand once and pasted in.
#     Works immediately, no further setup, but has to be copied into .env on every machine by hand.
#  2. VIMEO_CLIENT_ID + VIMEO_CLIENT_SECRET: identifies a Vimeo API app (same values shown on the
#     app's page where a personal access token would otherwise be generated). With just these two
#     set, a "Connect Vimeo" button appears in the app - click it and log in with the Vimeo account
#     once per machine, same shape as the SoundCloud connect flow below, and no token to copy by hand.
# Requires a Vimeo plan that supports API uploads either way (Pro/Business/Premium - not free).

# Option 1: a personal access token from https://developer.vimeo.com/apps - needs the public,
# private, upload, edit, and interact scopes.
VIMEO_ACCESS_TOKEN=

# Option 2: the Client Identifier and Client Secret from the same app page as above - leave
# VIMEO_ACCESS_TOKEN blank to use this instead, then click "Connect Vimeo" in the app.
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=

# Only needed if the app isn't reachable at http://localhost:3000 (e.g. a different port) - must
# exactly match the redirect URI registered with the Vimeo app. Only relevant to option 2.
VIMEO_REDIRECT_URI=

# Comma-separated showcase (album) IDs every published video gets added to, e.g. the current
# year's sermons, the current sermon series, and the all-sermons showcase. Find an ID in the
# showcase's URL: vimeo.com/showcase/XXXXXXX. Update this when the year or series changes.
VIMEO_SHOWCASE_IDS=

# Publishing to SoundCloud is also entirely optional, and needs an Artist-Pro SoundCloud account.
# Register an app at https://developers.soundcloud.com to get these two values - unlike Vimeo's
# single access token, SoundCloud also needs a one-time browser sign-in after this is filled in
# (use the "Connect SoundCloud" link that appears on the app's page once these are set).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Only needed if the app isn't reachable at http://localhost:3000 (e.g. a different port) - must
# exactly match the redirect URI registered with the SoundCloud app.
SOUNDCLOUD_REDIRECT_URI=

# Comma-separated playlist IDs every published track gets added to, e.g. the current year's
# sermons and the current sermon series. Find an ID in the playlist's URL.
SOUNDCLOUD_PLAYLIST_IDS=
